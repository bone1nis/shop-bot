# Токен от @BotFather
BOT_TOKEN=
# Чат или id менеджера, куда уходят вопросы по кнопке «Передать менеджеру» (необязательно)
MANAGER_CHAT_ID=
# 1 — показывать под ответом, на какие факты он опирается (удобно для демо)
SHOW_FACTS=1

# Необязательно. Без ключа бот отвечает только по правилам.
# Подходит любой OpenAI-совместимый API: OpenRouter, OpenAI, DeepSeek, локальная модель.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
